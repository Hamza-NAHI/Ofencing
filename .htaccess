# Apache 2.4 / XAMPP / ordinary PHP shared hosting. No front controller or build.
Options -Indexes -MultiViews
DirectoryIndex index.html index.php

# Relative rules preserve both domain-root and subdirectory installations.
# Missing requests reach the existing branded 404 through a small PHP adapter.
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule (^|/)\. - [F,L]
    RewriteRule ^(?:config|database|tests|docs)(?:/|$) - [F,L,NC]
    RewriteRule ^(?:README\.md|.*\.(?:sql|log|bak|ini))$ - [F,L,NC]
    RewriteRule ^(?:api|admin)/_ - [F,L]
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ 404.php [L]
</IfModule>

<FilesMatch "(^\.|\.(sql|log|bak|ini)$|^README\.md$)">
    Require all denied
</FilesMatch>
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>
